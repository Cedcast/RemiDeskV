# Application Settings
APP_NAME=RemiDesk
ADMIN_EMAIL=admin@example.com
APP_ENV=development
DEBUG=True

# Database
# For local development use SQLite:
DATABASE_URL=sqlite:///./app.db
# For production (PostgreSQL), Render will provide this automatically:
# DATABASE_URL=postgresql://user:password@host:port/database

# JWT Authentication (CHANGE IN PRODUCTION!)
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Frontend URL (for CORS in production)
FRONTEND_URL=http://localhost:5173

# ============ Optional Integrations ============

# Twilio (SMS & WhatsApp Notifications)
# TWILIO_ACCOUNT_SID=your-twilio-account-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_PHONE_NUMBER=+1234567890
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# SendGrid (Email Notifications)
# SENDGRID_API_KEY=your-sendgrid-api-key
# FROM_EMAIL=noreply@remidesk.com

# ============ Stripe (Billing) ============
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_PUBLISHABLE_KEY=pk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PREMIUM_PRICE_ID=price_...   # Create in Stripe Dashboard ($12/month)
# STRIPE_PRO_PRICE_ID=price_...       # Create in Stripe Dashboard ($39/month)

# ============ PayPal (Billing) ============
# PAYPAL_CLIENT_ID=...
# PAYPAL_CLIENT_SECRET=...
# PAYPAL_MODE=sandbox   # sandbox | live

# ============ OpenAI (AI-powered notifications) ============
# OPENAI_API_KEY=sk-...   # Optional: enables personalized AI-generated notification messages

# ============ Billing Settings ============
# FREE_TRIAL_DAYS=3
# APP_CURRENCY_DEFAULT=USD   # USD | GBP | CAD | AUD
