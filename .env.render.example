# ============================================================
# RemiDesk — Render Environment Variables
# ============================================================
# Copy these into Render Dashboard → appointment-api → Environment
# Replace all YOUR_*_HERE values with real keys
# ============================================================

# --- AUTO-SET BY RENDER (do not add manually) ---
# DATABASE_URL=            ← Render injects this from the PostgreSQL addon
# SECRET_KEY=              ← render.yaml auto-generates this

# --- REQUIRED ---
APP_ENV=production
SUPERADMIN_EMAIL=admin@remidesk.com
SUPERADMIN_PASSWORD=YOUR_STRONG_PASSWORD_HERE
SUPERADMIN_NAME=Platform Admin

# Frontend URL (update with your actual Render static site URL)
FRONTEND_URL=https://appointment-frontend.onrender.com
APP_BASE_URL=https://appointment-frontend.onrender.com

# --- TWILIO (SMS & WhatsApp reminders) ---
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID_HERE
TWILIO_AUTH_TOKEN=YOUR_TWILIO_AUTH_TOKEN_HERE
TWILIO_PHONE_NUMBER=+1XXXXXXXXXX
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# --- SENDGRID (Email notifications & verification) ---
SENDGRID_API_KEY=YOUR_SENDGRID_API_KEY_HERE
FROM_EMAIL=noreply@remidesk.com

# --- PAYSTACK (Payments & subscriptions) ---
PAYSTACK_SECRET_KEY=sk_live_YOUR_PAYSTACK_SECRET_HERE
PAYSTACK_PUBLIC_KEY=pk_live_YOUR_PAYSTACK_PUBLIC_HERE
PAYSTACK_WEBHOOK_SECRET=YOUR_PAYSTACK_WEBHOOK_SECRET_HERE

# --- OPENAI (AI-powered Pro reminders) ---
OPENAI_API_KEY=sk-YOUR_OPENAI_API_KEY_HERE

# --- OPTIONAL OVERRIDES ---
# FREE_TRIAL_DAYS=7
# APP_CURRENCY_DEFAULT=USD
# ACCESS_TOKEN_EXPIRE_MINUTES=30


# ============================================================
# FRONTEND ENV (set on the appointment-frontend static site)
# ============================================================
# VITE_API_URL=https://appointment-api.onrender.com/api
