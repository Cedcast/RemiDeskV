# API Configuration
# For local development, leave empty to use the proxy in vite.config.js
# For production deployment, set the full API URL
# VITE_API_URL=https://your-api-service.onrender.com/api

# App Name
VITE_APP_NAME=RemiDesk

# Stripe (Billing) — public key only
# VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...
